 typeface="Montserrat" panose="020F0502020204030204" pitchFamily="2" charset="0"/></a:rPr><a:t>Impedance </a:t></a:r><a:r><a:rPr lang="en-US" b="1" dirty="0"><a:solidFill><a:srgbClr val="02559A"/></a:solidFill><a:latin typeface="Montserrat" panose="020F0502020204030204" pitchFamily="2" charset="0"/></a:rPr><a:t>Tube for sound insulation</a:t></a:r><a:endParaRPr lang="en-IN" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="02559A"/></a:solidFill><a:effectLst/><a:latin typeface="Montserrat" panose="020F0502020204030204" pitchFamily="2" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="TextBox 3"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{72BB58F5-3389-3B3E-6D90-CB8C283514CD}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="4762099" y="1672731"/><a:ext cx="6097604" cy="3970318"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" dirty="0"/><a:t>The </a:t></a:r><a:r><a:rPr lang="en-US" b="1" dirty="0"/><a:t>Placid Impedance Tube</a:t></a:r><a:r><a:rPr lang="en-US" dirty="0"/><a:t> is a precision instrument used to measure normal incidence sound absorption coefficient, reflection coefficient, and acoustic impedance of materials using the transfer function method in accordance with </a:t></a:r><a:r><a:rPr lang="en-US" b="1" dirty="0"/><a:t>ASTM E1050</a:t></a:r><a:r><a:rPr lang="en-US" dirty="0"/><a:t> and </a:t></a:r><a:r><a:rPr lang="en-US" b="1" dirty="0"/><a:t>ISO 10534-2</a:t></a:r><a:r><a:rPr lang="en-US" dirty="0"/><a:t>. It typically supports a frequency range of ~100 Hz to 6,400 Hz depending on tube diameter (e.g., 29 mm and 100 mm tubes) and uses high-sensitivity microphones with digital signal processing for accurate measurements. The system accommodates circular samples (commonly 29 mm or 100 mm diameter) with thickness up to ~50 mm and includes an integrated data acquisition unit and analysis software. It is widely used for characterizing porous, fibrous, and aerogel-based acoustic insulation materials.</a:t></a:r><a:endParaRPr lang="en-IN" dirty="0"/></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="4098" name="Picture 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{86B3BF68-C318-4AC9-6EDB-901C6FA3597D}"/></a:ext></a:extLst></p:cNvPr><p:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId2"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr bwMode="auto"><a:xfrm><a:off x="526669" y="1408761"/><a:ext cx="4023673" cy="4023673"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:extLst><a:ext uri="{909E8E84-426E-40DD-AFC4-6F175D3DCCD1}"><a14:hiddenFill xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main"><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill></a14:hiddenFill></a:ext></a:extLst></p:spPr></p:pic></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="4167194412"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>