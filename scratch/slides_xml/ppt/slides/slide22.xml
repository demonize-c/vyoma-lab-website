r val="000000"/></a:solidFill><a:effectLst/><a:latin typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/></a:rPr><a:t>Extreme Weather Clothing</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="8" name="TextBox 7"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{AFD2E965-9E8A-2E3C-8A16-CABA08375261}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="4403555" y="1385742"/><a:ext cx="6896503" cy="2308324"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Extreme weather clothing is engineered to protect the human body from harsh environmental conditions such as extreme cold, heat, wind, and moisture.</a:t></a:r><a:br><a:rPr lang="en-US" dirty="0"/></a:br><a:r><a:rPr lang="en-US" dirty="0"/><a:t>It incorporates advanced materials like aerogel insulation, phase change materials (PCMs), and multilayer systems to regulate heat transfer and maintain thermal comfort. Such clothing is critical for applications in polar expeditions, high-altitude mountaineering, military operations, and cryogenic or industrial environments.</a:t></a:r><a:endParaRPr lang="en-IN" dirty="0"/></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="11" name="Picture 10"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F6693B25-1018-924C-FFBB-4609B091F747}"/></a:ext></a:extLst></p:cNvPr><p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId2"/><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr><a:xfrm><a:off x="104979" y="1016410"/><a:ext cx="4298576" cy="3440087"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prst